{
  "name": "detail-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Exploded axonometric viewer for Rhino models",
  "scripts": {
    "postinstall": "node scripts/copy-rhino3dm.mjs",
